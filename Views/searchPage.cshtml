@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Core.Models.Blocks;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = "masterTemplate.cshtml";
}

<div class="d-flex flex-column flex-lg-row">
    <!-- DYNAMIC SIDEBAR PARTIAL -->
    @await Html.PartialAsync("custom/Sidebar", Model)
    <div class="flex-grow-1 p-4">
<!-- Breadcrumb Start ------------------------------------------------------------------------------>
        <div class="container-flex">
            <div class="container">
                <div class="flex-grow-1 p-4">
                    @* Render the dynamic breadcrumb partial view *@
                    @await Html.PartialAsync("custom/Breadcrumbs")
                </div>
            </div>
        </div>
<!-- Breadcrumb End -------------------------------------------------------------------------------->
<!-- Heading Start --------------------------------------------------------------------------------->
        <div class="container-flex">
            <div class="container pt-3 pb-3">
            <h1 class="gradient ps-4 pe-4 pb-2">@Model.Name</h1>
            </div>
        </div>
<!-- Heading End ----------------------------------------------------------------------------------->
<!-- Search Partial View --------------------------------------------------------------------------->
            <div class="container-flex">
                <div class="container ps-4 pe-4">
                    <div class="row g-4">
                        @* Render Search Partial *@
                        @await Html.PartialAsync("custom/Search", Model)
                    </div>
                </div>
            </div>
<!-- Search End ------------------------------------------------------------------------------------>
    </div>
</div>