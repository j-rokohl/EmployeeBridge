@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Core.Models;
@using Umbraco.Cms.Core.Models.Blocks;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.HomePage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "masterTemplate.cshtml";
}


<!-- Carousel Start -------------------------------------------------------------------------------->
@if (Model.Value<string>("showOrHideCarousel") == "Show")
{
      var carouselBlocks = Model.Value<BlockListModel>("carouselGroupCollection");

  @if (carouselBlocks != null && carouselBlocks.Any())
  {
      @await Html.PartialAsync("~/Views/Partials/custom/CarouselGroup.cshtml", carouselBlocks)
  }

}
<!-- Carousel End ---------------------------------------------------------------------------------->
<!-- Icon Grid Start ------------------------------------------------------------------------------->
@if (Model.Value<string>("showOrHideIconGrid") == "Show")
{
    var iconGridBlocks = Model.Value<BlockListModel>("iconGridElements");

@if (iconGridBlocks != null && iconGridBlocks.Any())
{
    @await Html.PartialAsync("custom/IconGrid", iconGridBlocks)
}
}
<!-- Icon Grid End --------------------------------------------------------------------------------->
<!-- Content Start --------------------------------------------------------------------------------->
@if (Model.Value<string>("showOrHideContent") == "Show")
{
  <div class="container-flex">
    <div class="container pt-5 pb-5">
      <h1 class="gradient mb-4">@Model.Value("pageTitle")</h1>
      <div>@Model.Value("bodyText")</div>
    </div>
  </div>
}
<!-- Content End ----------------------------------------------------------------------------------->
<!-- Feature Start --------------------------------------------------------------------------------->
@if (Model.Value<string>("showOrHideFeatureContent") == "Show")
{
    var featureImage = Model.Value<IPublishedContent>("featureImage");
    var featureButton = Model.Value<IEnumerable<Link>>("featureButton")?.FirstOrDefault() 
                        ?? Model.Value<Link>("featureButton");

    <div class="container-flex bg-light">
        <div class="container pt-5 pb-5">
            <div class="row section align-items-center">
                <div class="col-md-8">
                    @if (Model.HasValue("featureTitle"))
                    {
                        <h2 class="gradient mb-4">@Model.Value("featureTitle")</h2>
                    }
                    
                    @if (Model.HasValue("contentEditor"))
                    {
                        <div class="mb-4">
                            @Model.Value("contentEditor")
                        </div>
                    }

                    @if (featureButton != null)
                    {
                        <a href="@featureButton.Url" 
                           target="@(string.IsNullOrWhiteSpace(featureButton.Target) ? "_self" : featureButton.Target)" 
                           class="btn btn-success px-5">
                            @(string.IsNullOrWhiteSpace(featureButton.Name) ? "Learn More" : featureButton.Name)
                        </a>
                    }
                </div>

                <div class="col-md-4 text-center">
                    @if (featureImage != null)
                    {
                        <img src="@featureImage.Url()" 
                             alt="@(featureImage.Value<string>("altText") ?? Model.Value<string>("featureTitle") ?? "Featured Image")" 
                             class="img-fluid" 
                             style="max-width: 300px;">
                    }
                </div>
            </div>
        </div>
    </div>
}
<!-- Feature End ----------------------------------------------------------------------------------->
<!-- Card Group Start ------------------------------------------------------------------------------>
@if (Model.Value<string>("showOrHideCards") == "Show")
{

<div class="container-flex">
    <div class="container pt-5 pb-5">
        <h2 class="gradient mb-4">@Model.Value("cardGroupTitle")</h2>

            @{
            var cardGroupBlocks = Model.Value<BlockListModel>("cardGroup");
            
            // Read dropdown from HomePage Document Type
            int itemsPerRow = Model.Value<int>("cardGroupSettings");

            // Fallback if dropdown is unselected or 0
            if (itemsPerRow == 0 && cardGroupBlocks != null)
            {
                int count = cardGroupBlocks.Count();
                itemsPerRow = count switch { 2 => 2, 3 => 3, 5 => 5, _ => 4 };
            }
            }

        @if (cardGroupBlocks != null && cardGroupBlocks.Any())
        {
            @* Pass both cards and the column count via ViewData *@
            @await Html.PartialAsync(
                "~/Views/Partials/custom/CardGroup.cshtml", 
                cardGroupBlocks, 
                new ViewDataDictionary(ViewData) { { "ItemsPerRow", itemsPerRow } }
            )
        }
    </div>
</div>
}
<!-- Card Group End -------------------------------------------------------------------------------->
<!-- Accordion Start ------------------------------------------------------------------------------->
@if (Model.Value<string>("showOrHideAccordion") == "Show")
{
<div class="container-flex bg-light">
    <div class="container pt-5 pb-5">
        <h2 class="gradient mb-4">Frequently Asked Questions</h2>

        @{
            // Replace "faqAccordion" with your actual Block List property alias on HomePage
            var faqBlocks = Model.Value<BlockListModel>("accordionGroupItems");
        }

        @if (faqBlocks != null && faqBlocks.Any())
        {
            @await Html.PartialAsync("~/Views/Partials/custom/AccordionGroup.cshtml", faqBlocks)
        }
    </div>
</div>
}
<!-- Accordion End --------------------------------------------------------------------------------->
