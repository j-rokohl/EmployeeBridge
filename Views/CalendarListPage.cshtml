@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "masterTemplate.cshtml";

    // Query parameters for filter and search
    var selectedDeptId = Context.Request.Query["deptId"].ToString();
    var searchQuery = Context.Request.Query["q"].ToString()?.Trim() ?? string.Empty;

    // Fetch child event nodes ordered chronologically by eventDate
    var events = Model.Children()
        .Where(x => x.IsVisible() && x.ContentType.Alias == "calendarItemPage")
        .OrderBy(x => x.Value<DateTime>("eventDate"))
        .ToList();
}

<div class="d-flex flex-column flex-lg-row">
    @await Html.PartialAsync("custom/Sidebar", Model)
    <div class="flex-grow-1 p-4">
        <!-- Breadcrumb -->
        <div class="container-flex">
            <div class="container">
                <div class="p-4">
                    @await Html.PartialAsync("custom/Breadcrumbs")
                </div>
            </div>
        </div>

        <!-- Title -->
        <div class="container-flex">
            <div class="container pt-3 pb-3">
                <h1 class="gradient ps-4 pe-4 pb-4">@Model.Name</h1>

                <!-- Event List & Sidebar Grid -->
                <div class="container-flex">
                    <div class="container ps-4 pe-4">
                        <div class="row g-4">
                            <!-- Events Feed -->
                            <div class="col-lg-9">
                                @if (events.Any())
                                {
                                    foreach (var item in events)
                                    {
                                        var eventTitle = item.Value<string>("eventTitle");
                                        var eventDate = item.Value<DateTime>("eventDate");
                                        var location = item.Value<string>("location");
                                        var shortDesc = item.Value<string>("shortDescription");
                                        var depts = item.Value<IEnumerable<IPublishedContent>>("department") ?? Enumerable.Empty<IPublishedContent>();

                                        <div class="row ms-2 me-2 mb-4">
                                            <!-- Blue Date Badge Block -->
                                            <div style="width: 80px; height: 80px; background-color: #273370;" class="me-3 col-2 text-center rounded">
                                                <div class="fw-bold h3 mt-2 mb-0 text-white">@eventDate.ToString("dd")</div>
                                                <div class="fw-bold text-white text-uppercase">@eventDate.ToString("MMM")</div>
                                            </div>

                                            <!-- Details -->
                                            <div class="col-9">
                                                <a href="@item.Url()" class="text-decoration-none">
                                                    <h5 class="card-title text-dark headline mb-1">@eventTitle</h5>
                                                </a>
                                                
                                                <p class="card-text text-muted small mb-2">
                                                    <i class="bi bi-clock me-1"></i>@eventDate.ToString("h:mm tt")
                                                    @if (!string.IsNullOrWhiteSpace(location))
                                                    {
                                                        <span class="ms-2 me-2">|</span><i class="bi bi-geo-alt me-1"></i>@location
                                                    }
                                                </p>

                                                @if (depts.Any())
                                                {
                                                    <div class="mb-2 d-flex flex-wrap gap-1">
                                                        @foreach (var dept in depts)
                                                        {
                                                            <span class="badge bg-success">@dept.Name</span>
                                                        }
                                                    </div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(shortDesc))
                                                {
                                                    <p class="mb-0 text-secondary">@shortDesc</p>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-info ms-2 me-2">No upcoming events found.</div>
                                }
                            </div>

                            <!-- Filter/Search Sidebar -->
                            <div class="col-lg-3">
                                <div class="card border-0 bg-light p-3">
                                    <h6 class="fw-bold text-uppercase text-muted small mb-3">Search Events</h6>
                                    <form method="get" action="@Model.Url()" class="mb-4 border-bottom">
                                        <div class="input-group mb-4">
                                            <input type="text" name="q" value="@searchQuery" class="form-control form-control-sm round-input me-2" placeholder="Search events..." />
                                            <button class="btn btn-sm btn-primary" type="submit">
                                                <i class="bi bi-search"></i>
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>