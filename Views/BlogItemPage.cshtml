@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Core.Models;
@using Umbraco.Extensions;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage;
@{
	Layout = "masterTemplate.cshtml";

    // Find the news landing page to generate clean, dynamic URLs
    var newsPage = Umbraco.ContentAtRoot()
        .SelectMany(x => x.DescendantsOrSelf())
        .FirstOrDefault(x => string.Equals(x.ContentType.Alias, "blogListPage", StringComparison.OrdinalIgnoreCase));

    var newsBaseUrl = newsPage?.Url() ?? "/news/";

    var departments = Model.Value<IEnumerable<IPublishedContent>>("department") ?? Enumerable.Empty<IPublishedContent>();

}

<div class="d-flex flex-column flex-lg-row">
    <!-- DYNAMIC SIDEBAR PARTIAL -->
    @await Html.PartialAsync("custom/Sidebar", Model)
    <div class="flex-grow-1 p-4">
<!-- Breadcrumb Start -------------------------------------------------------------------------------->
        <div class="container-flex">
            <div class="container">
                <div class="flex-grow-1 p-4">
                    @* Render the dynamic breadcrumb partial view *@
                    @await Html.PartialAsync("custom/Breadcrumbs")
                </div>
            </div>
        </div>
<!-- Breadcrumb End ---------------------------------------------------------------------------------->
<!-- Content Start --------------------------------------------------------------------------------->
        <div class="container-flex">
            <div class="container pt-3 pb-3">
            <h1 class="gradient ps-4 pe-4 pb-2">@Model.Name</h1>
            @{
                var authorNode = Model.Value<IPublishedContent>("author");
            }

            @if (authorNode != null || Model.Value<DateTime?>("publicationDate") != null || departments != null)
                {
                <div class="ps-4">
                    <div style="border-left: 3px solid green;" class="green-border">
                    @if (authorNode != null)
                    {
                        var authorName = authorNode.Value<string>("authorName") ?? authorNode.Name;
                        var department = authorNode.Value<string>("authorDepartment");

                        <div class="ps-4 pe-4 d-flex align-items-center pb-3 pt-4">
                            <div>
                                <strong>By @authorName</strong>
                                @if (!string.IsNullOrWhiteSpace(department))
                                {
                                    <span class="ms-2 me-2">|</span>
                                    <span>@department</span>
                                }
                            </div>
                        </div>
                    }

                    @if (Model.Value<DateTime?>("publicationDate") != null)
                    {
                        var postDate = Model.Value<DateTime>("publicationDate");
                        <p class="ps-4 pe-4">@postDate.ToString("MMMM dd, yyyy")  <span class="ms-2 me-2">|</span>  Updated: @postDate.ToString("h:mm tt")</p>
                    }

                    @if (departments.Any())
                    {
                        <div class="ps-4 pe-4 pb-4 mb-4 d-flex flex-wrap gap-1 h5">
                            @foreach (var dept in departments)
                            {
                                var deptUrl = $"{newsBaseUrl}?deptId={dept.Id}";
                                <a href="@deptUrl" class="text-decoration-none">
                                    <span class="badge bg-success">@dept.Name</span>
                                </a>
                            }
                        </div>
                    }

                    </div>
                </div>
            }

            <h2 class="h5 p-4 blue-link">@Model.Value("introText")</h2>
            <div class="ps-4 pe-4">@Model.Value("bodyText")</div>
            </div>
        </div>
<!-- Content End ----------------------------------------------------------------------------------->
    </div>
</div>
