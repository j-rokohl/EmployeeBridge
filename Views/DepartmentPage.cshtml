@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.Blocks;
@{
	Layout = "masterTemplate.cshtml";
}

<div class="d-flex flex-column flex-lg-row">
    <!-- DYNAMIC SIDEBAR PARTIAL -->
    @await Html.PartialAsync("custom/Sidebar", Model)
    <div class="flex-grow-1 p-4">

<!-- Banner Start ---------------------------------------------------------------------------------->
@{
    var bannerText = Model.Value("bannerText");
}
<div class="container-flex">
    <div class="container">
        <div class="flex-grow-1 p-4">
            @* Render the dynamic breadcrumb partial view *@
            @await Html.PartialAsync("custom/Breadcrumbs")
        </div>
        <div class="card bg-dark text-white border-0" style="max-width: 1296px;"> 
            <!-- The background image --> <img src="/media/qwzoairp/banner-img.png" class="card-img" alt="Background Image" style="border-radius: 15px !important;"> 
            <!-- The text container overlaid on top --> 
            <div class="card-img-overlay d-flex align-items-center" style="padding: 0 !important;"> 
                @if (bannerText != null)
                {
                <div style="background-color: green; padding-left: 1em; padding-top: 1em; padding-bottom: .75em; padding-right: 1.5em; border-radius: 0 1em 1em 0;">
                <h1>@Model.Value("bannerText")</h1>
                </div>
                }
            </div> 
        </div>
    </div>
</div>
<!-- Banner End ------------------------------------------------------------------------------------>
<!-- Content Start --------------------------------------------------------------------------------->
@if (Model.Value<string>("showOrHideContent") == "Show")
{
  <div class="container-flex">
    <div class="container pt-3 pb-3">
      <h2 class="h3 gradient p-4">@Model.Value("pageTitle")</h2>
      <div class="ps-4 pe-4">@Model.Value("bodyText")</div>
    </div>
  </div>
}
<!-- Content End ----------------------------------------------------------------------------------->
<!-- Icon Grid Start ------------------------------------------------------------------------------->
@if (Model.Value<string>("showOrHideIconGrid") == "Show")
{
    var iconGridBlocks = Model.Value<BlockListModel>("iconGridElements");

@if (iconGridBlocks != null && iconGridBlocks.Any())
{
    @await Html.PartialAsync("custom/IconGrid", iconGridBlocks)
}
}
<!-- Icon Grid End --------------------------------------------------------------------------------->
<!-- Card Group Start ------------------------------------------------------------------------------>
@if (Model.Value<string>("showOrHideCards") == "Show")
{

<div class="container-flex">
    <div class="container py-5">
        <h2 class="gradient p-4">@Model.Value("cardGroupTitle")</h2>
            <div class="ps-4 pe-4">
            @{
            var cardGroupBlocks = Model.Value<BlockListModel>("cardGroup");
            
            // Read dropdown from HomePage Document Type
            int itemsPerRow = Model.Value<int>("cardGroupSettings");

            // Fallback if dropdown is unselected or 0
            if (itemsPerRow == 0 && cardGroupBlocks != null)
            {
                int count = cardGroupBlocks.Count();
                itemsPerRow = count switch { 2 => 2, 3 => 3, 5 => 5, _ => 4 };
            }
            }
        @if (cardGroupBlocks != null && cardGroupBlocks.Any())
        {
            @* Pass both cards and the column count via ViewData *@
            @await Html.PartialAsync(
                "~/Views/Partials/custom/CardGroup.cshtml", 
                cardGroupBlocks, 
                new ViewDataDictionary(ViewData) { { "ItemsPerRow", itemsPerRow } }
            )
        }
        </div>
    </div>
</div>
}
<!-- Card Group End -------------------------------------------------------------------------------->
