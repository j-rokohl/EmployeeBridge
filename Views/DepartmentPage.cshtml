@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage;
@using Umbraco.Cms.Core.Models.Blocks;
@using Umbraco.Cms.Core.Models;
@{
	Layout = "masterTemplate.cshtml";
}

<div class="d-flex flex-column flex-lg-row">
<!-- DYNAMIC SIDEBAR PARTIAL ----------------------------------------------------------------------->
    @await Html.PartialAsync("custom/Sidebar", Model)
    <div class="flex-grow-1 p-4">

<!-- Banner Start ---------------------------------------------------------------------------------->
@{
    var bannerText = Model.Value("bannerText");
}
<div class="container-flex">
    <div class="container">
        <div class="flex-grow-1 p-4">
            @* Render the dynamic breadcrumb partial view *@
            @await Html.PartialAsync("custom/Breadcrumbs")
        </div>
        <div class="card bg-dark text-white border-0" style="max-width: 1296px;"> 
            <!-- The background image --> <img src="/media/qwzoairp/banner-img.png" class="card-img" alt="Background Image" style="border-radius: 15px !important;"> 
            <!-- The text container overlaid on top --> 
            <div class="card-img-overlay d-flex align-items-center" style="padding: 0 !important;"> 
                @if (bannerText != null)
                {
                <div style="background-color: #1a8f39; padding-left: 1em; padding-top: 1em; padding-bottom: .75em; padding-right: 1.5em; border-radius: 0 1em 1em 0;">
                <h1>@Model.Value("bannerText")</h1>
                </div>
                }
            </div> 
        </div>
    </div>
</div>
<!-- Banner End ------------------------------------------------------------------------------------>
<!-- Content Start --------------------------------------------------------------------------------->
@if (Model.Value<string>("showOrHideContent") == "Show")
{
  <div class="container-flex">
    <div class="container pt-3 pb-3">
      <h2 class="gradient p-4">@Model.Value("pageTitle")</h2>
      <div class="ps-4 pe-4">@Model.Value("bodyText")</div>
    </div>
  </div>
}
<!-- Content End ----------------------------------------------------------------------------------->
<!-- Icon Grid Start ------------------------------------------------------------------------------->
@if (Model.Value<string>("showOrHideIconGrid") == "Show")
{
    var iconGridBlocks = Model.Value<BlockListModel>("iconGridElements");

@if (iconGridBlocks != null && iconGridBlocks.Any())
{
    @await Html.PartialAsync("custom/IconGrid", iconGridBlocks)
}
}
<!-- Icon Grid End --------------------------------------------------------------------------------->
<!-- Card Group Start ------------------------------------------------------------------------------>
@if (Model.Value<string>("showOrHideCards") == "Show")
{

<div class="container-flex">
    <div class="container py-5">
        <h2 class="gradient p-4">@Model.Value("cardGroupTitle")</h2>
            <div class="ps-4 pe-4">
            @{
            var cardGroupBlocks = Model.Value<BlockListModel>("cardGroup");
            
            // Read dropdown from HomePage Document Type
            int itemsPerRow = Model.Value<int>("cardGroupSettings");

            // Fallback if dropdown is unselected or 0
            if (itemsPerRow == 0 && cardGroupBlocks != null)
            {
                int count = cardGroupBlocks.Count();
                itemsPerRow = count switch { 2 => 2, 3 => 3, 5 => 5, _ => 4 };
            }
            }
        @if (cardGroupBlocks != null && cardGroupBlocks.Any())
        {
            @* Pass both cards and the column count via ViewData *@
            @await Html.PartialAsync(
                "~/Views/Partials/custom/CardGroup.cshtml", 
                cardGroupBlocks, 
                new ViewDataDictionary(ViewData) { { "ItemsPerRow", itemsPerRow } }
            )
        }
        </div>
    </div>
</div>
}
<!-- Card Group End -------------------------------------------------------------------------------->
<!-- Feature Start --------------------------------------------------------------------------------->
@if (Model.Value<string>("showOrHideFeatureContent") == "Show")
{
    var featureImage = Model.Value<IPublishedContent>("featureImage");
    var featureButton = Model.Value<IEnumerable<Link>>("featureButton")?.FirstOrDefault() 
                        ?? Model.Value<Link>("featureButton");

    <div class="container-flex">
        <div class="container py-5">
            <div class="row section align-items-center ps-4 pe-4">
                <div class="col-md-8">
                    @if (Model.HasValue("featureTitle"))
                    {
                        <h2 class="gradient mb-4">@Model.Value("featureTitle")</h2>
                    }
                    
                    @if (Model.HasValue("contentEditor"))
                    {
                        <div class="mb-4">
                            @Model.Value("contentEditor")
                        </div>
                    }

                    @if (featureButton != null)
                    {
                        <a href="@featureButton.Url" 
                           target="@(string.IsNullOrWhiteSpace(featureButton.Target) ? "_self" : featureButton.Target)" 
                           class="btn btn-success px-5">
                            @(string.IsNullOrWhiteSpace(featureButton.Name) ? "Learn More" : featureButton.Name)
                        </a>
                    }
                </div>

                <div class="col-md-4 text-center">
                    @if (featureImage != null)
                    {
                        <img src="@featureImage.Url()" 
                             alt="@(featureImage.Value<string>("altText") ?? Model.Value<string>("featureTitle") ?? "Featured Image")" 
                             class="img-fluid" 
                             style="max-width: 300px;">
                    }
                </div>
            </div>
        </div>
    </div>
}
<!-- Feature End ----------------------------------------------------------------------------------->
<!-- News Feed Start ------------------------------------------------------------------------------->
@if (Model.Value<string>("showOrHideNewsFeed") == "Show")
{
<div class="container-flex">
    <div class="container py-5">

        @{
            var newsLink = Model.Value<IEnumerable<Link>>("linkToMoreNews")?.FirstOrDefault() 
                   ?? Model.Value<Link>("linkToMoreNews");
        }

        <h2 class="gradient ps-4 pe-4 pt-4 pb-2">@Model.Value("newsFeedTitle")</h2>

            @if (newsLink != null && !string.IsNullOrWhiteSpace(newsLink.Url))
            {
                var linkText = !string.IsNullOrWhiteSpace(newsLink.Name) ? newsLink.Name : "View All News";
                var target = string.IsNullOrWhiteSpace(newsLink.Target) ? "_self" : newsLink.Target;

                <p class="ps-4 pe-4 pb-4">
                    <a class="blue-link fw-bold text-decoration-none" href="@newsLink.Url" target="@target">
                        @linkText <i class="bi bi-chevron-right" style="-webkit-text-stroke: 1px;"></i>
                    </a>
                </p>
            }

        @await Html.PartialAsync("custom/NewsFeedDepartmentPage", Model)
    </div>
</div>
}
<!-- News Feed End --------------------------------------------------------------------------------->
<!-- Team Leader Start ----------------------------------------------------------------------------->
@if (Model.Value<string>("showOrHideTeamMemberCards") == "Show")
{

var teamLink = Model.Value<IEnumerable<Link>>("linkToMoreStaff")?.FirstOrDefault() 
                   ?? Model.Value<Link>("linkToMoreStaff");

<div class="container-flex">
    <div class="container py-5">
        <h2 class="gradient pt-4 ps-4 pb-2">@Model.Value("teamMemberCardsTitle")</h2>
            @if (teamLink != null && !string.IsNullOrWhiteSpace(teamLink.Url))
            {
                var linkText = !string.IsNullOrWhiteSpace(teamLink.Name) ? teamLink.Name : "Team Members";
                var target = string.IsNullOrWhiteSpace(teamLink.Target) ? "_self" : teamLink.Target;

                <p class="pb-4">
                    <a class="ps-4 blue-link fw-bold text-decoration-none" href="@teamLink.Url" target="@target">
                        @linkText <i class="bi bi-chevron-right" style="-webkit-text-stroke: 1px;"></i>
                    </a>
                </p>
            }
        <div class="row row-cols-1 row-cols-md-1 row-cols-lg-2 g-5 ps-4 pe-4">
            @{
            var teamMemberBlocks = Model.Value<BlockListModel>("teamMemberCardGroup");
            }
        @if (teamMemberBlocks != null && teamMemberBlocks.Any())
        {
            @await Html.PartialAsync(
                "~/Views/Partials/custom/teamMemberCards.cshtml", 
                teamMemberBlocks
            )
        }
        </div>    
    </div>
</div>
}
<!-- Team Leader End -------------------------------------------------------------------------------->
    </div>
</div>