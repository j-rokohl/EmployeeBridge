@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    var item = Model;
    var isBlogList = item.ContentType.Alias == "blogListPage";
    
    // 1. Do not fetch children if the current node is a BlogListPage
    var visibleChildren = isBlogList 
        ? Enumerable.Empty<IPublishedContent>()
        : item.Children().Where(x => x.IsVisible()).ToList();

    // 2. BlogListPage should never act as a parent container in the sidebar UI
    var hasChildren = !isBlogList && visibleChildren.Any();

    // Safely retrieve the actual active page from ViewData
    var currentContent = ViewData["CurrentPage"] as IPublishedContent;
    var currentId = currentContent?.Id ?? 0;

    // Checks: Is THIS the active page, or is the active page a child under this node?
    var isCurrentPage = currentId == item.Id;
    var isParentOfActive = currentContent != null && currentContent.Ancestors().Any(a => a.Id == item.Id);

    // Strictly expand ONLY if on this page or on a child of this tree
    var shouldExpand = isCurrentPage || isParentOfActive;

    var collapseId = $"menu-node-{item.Id}";

    // --- TITLE RESOLUTION LOGIC ---
    // Fetch value directly from the item (works natively across compositions)
    var customTitleOverride = item.Value<string>("sidebarLinkTitle");
    var linkTitle = !string.IsNullOrWhiteSpace(customTitleOverride) 
        ? customTitleOverride.Trim() 
        : item.Name;

    // --- ICON RESOLUTION LOGIC ---
    var customIconOverride = item.Value<string>("sidebarIconOverride");
    string iconClass;

    if (!string.IsNullOrWhiteSpace(customIconOverride))
    {
        // 1. Backoffice Override
        iconClass = customIconOverride.Trim();
    }
    else
    {
        // 2. Default Fallbacks by Template / Alias
        iconClass = item.ContentType.Alias switch
        {
            "homePage" => "bi-house-door",
            "departmentPage" => "bi-bank",
            "blogListPage" => "bi-newspaper",
            "detailPage" => "bi-file-earmark",
            "blogItemPage" => "bi-file-earmark-text",
            "documentLibraryPage" => "bi-archive",
            "staffPage" => "bi-person",
            "searchPage" => "bi-search",
            _ => hasChildren ? "bi-folder" : "bi-file-earmark"
        };

        // If the item has children and isn't an explicitly mapped page type, default to folder
        if (hasChildren && item.ContentType.Alias != "DepartmentPage")
        {
            iconClass = "bi-folder";
        }
    }
}

<li>
    @if (hasChildren)
    {
        <div class="nav-item-btn @(isCurrentPage ? "active" : "") p-0">
            @* Direct Link to the parent page *@
            <a href="@item.Url()" class="flex-grow-1 text-decoration-none text-reset py-2 ps-2 pe-1 d-flex align-items-center">
                <i class="bi @iconClass me-2"></i>
                <span>@linkTitle</span>
            </a>

            @* Toggle button for dropdown collapse *@
            <button class="btn btn-link text-reset p-2 border-0 shadow-none @(shouldExpand ? "" : "collapsed")"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#@collapseId"
                    aria-expanded="@(shouldExpand ? "true" : "false")"
                    aria-label="Toggle @linkTitle Submenu">
                <i class="bi bi-chevron-right toggle-icon"></i>
            </button>
        </div>

        @* Submenu Tree *@
        <div class="collapse @(shouldExpand ? "show" : "")" id="@collapseId">
            <ul>
                @foreach (var child in visibleChildren)
                {
                    @await Html.PartialAsync("custom/SidebarItem", child, ViewData)
                }
            </ul>
        </div>
    }
    else
    {
        <a href="@item.Url()" class="nav-item-btn @(isCurrentPage ? "active" : "") flex-grow-1 text-decoration-none text-reset py-2 ps-2 pe-1 d-flex align-items-center" style="justify-content: flex-start;">
            <i class="bi @iconClass me-2"></i>
            <span>@linkTitle</span>
        </a>
    }
</li>