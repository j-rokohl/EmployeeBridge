@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    var item = Model;

    // --- HIDE FROM MENU CHECK ---
    // If the node has "hideFromMenu" checked, render nothing and exit immediately
    if (item.HasProperty("hideFromMenu") && item.Value<bool>("hideFromMenu"))
    {
        return;
    }

    var isBlogList = item.ContentType.Alias == "blogListPage";
    var isCalendarList = item.ContentType.Alias == "calendarListPage";
    
    // Combine both list containers so neither renders child items in the sidebar
    var isFeedList = isBlogList || isCalendarList;
    
    // 1. Do not fetch children if the current node is a BlogListPage or CalendarListPage,
    // and filter out any children that have "hideFromMenu" enabled.
    var visibleChildren = isFeedList 
        ? Enumerable.Empty<IPublishedContent>()
        : item.Children().Where(x => x.IsVisible() && !(x.HasProperty("hideFromMenu") && x.Value<bool>("hideFromMenu"))).ToList();

    // 2. Feed list pages should never act as parent containers in the sidebar UI
    var hasChildren = !isFeedList && visibleChildren.Any();

    // Safely retrieve the actual active page from ViewData
    var currentContent = ViewData["CurrentPage"] as IPublishedContent;
    var currentId = currentContent?.Id ?? 0;

    // Checks: Is THIS the active page, or is the active page a child under this node?
    var isCurrentPage = currentId == item.Id;
    var isParentOfActive = currentContent != null && currentContent.Ancestors().Any(a => a.Id == item.Id);

    // Strictly expand ONLY if on this page or on a child of this tree
    var shouldExpand = isCurrentPage || isParentOfActive;

    var collapseId = $"menu-node-{item.Id}";

    // --- URL & TARGET RESOLUTION LOGIC ---
    string navUrl = item.Url();
    string navTarget = "_self";

    // Checks for Menu Link doc types or any page with a Multi URL Picker property named 'link'
    if (item.ContentType.Alias.Equals("menuLinkPage", StringComparison.OrdinalIgnoreCase) 
        || item.ContentType.Alias.Equals("menuLink", StringComparison.OrdinalIgnoreCase) 
        || item.HasProperty("link"))
    {
        var pickedLink = item.Value<Link>("link");
        var openInNewWindow = item.Value<bool>("openInNewWindow");

        if (pickedLink != null)
        {
            navUrl = pickedLink.Url;
            navTarget = openInNewWindow || pickedLink.Target == "_blank" ? "_blank" : "_self";
        }
    }

    // --- TITLE RESOLUTION LOGIC ---
    var customTitleOverride = item.Value<string>("sidebarLinkTitle");
    var linkTitle = !string.IsNullOrWhiteSpace(customTitleOverride) 
        ? customTitleOverride.Trim() 
        : item.Name;

    // --- ICON RESOLUTION LOGIC ---
    var customIconOverride = item.Value<string>("sidebarIconOverride");
    string iconClass;

    if (!string.IsNullOrWhiteSpace(customIconOverride))
    {
        iconClass = customIconOverride.Trim();
    }
    else
    {
        iconClass = item.ContentType.Alias switch
        {
            "homePage" => "bi-house-door",
            "departmentPage" => "bi-bank",
            "blogListPage" => "bi-newspaper",
            "detailPage" => "bi-file-earmark",
            "blogItemPage" => "bi-file-earmark-text",
            "documentLibraryPage" => "bi-archive",
            "staffPage" => "bi-person",
            "searchPage" => "bi-search",
            "menuLink" => "bi-file-earmark",
            "faqPage" => "bi-question-circle",
            "calendarItemPage" => "bi-calendar3",
            "calendarListPage" => "bi-calendar3",
            _ => hasChildren ? "bi-folder" : "bi-file-earmark"
        };

        if (hasChildren && item.ContentType.Alias != "departmentPage")
        {
            iconClass = "bi-folder";
        }
    }
}

<li>
    @if (hasChildren)
    {
        <div class="nav-item-btn @(isCurrentPage ? "active" : "") p-0">
            @* Direct Link to the parent page *@
            <a href="@navUrl" target="@navTarget" class="flex-grow-1 text-decoration-none text-reset py-2 ps-2 pe-1 d-flex align-items-center">
                <i class="bi @iconClass me-2"></i>
                <span>@linkTitle</span>
            </a>

            @* Toggle button for dropdown collapse *@
            <button class="btn btn-link text-reset p-2 border-0 shadow-none @(shouldExpand ? "" : "collapsed")"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#@collapseId"
                    aria-expanded="@(shouldExpand ? "true" : "false")"
                    aria-label="Toggle @linkTitle Submenu">
                <i class="bi bi-chevron-right toggle-icon"></i>
            </button>
        </div>

        @* Submenu Tree *@
        <div class="collapse @(shouldExpand ? "show" : "")" id="@collapseId">
            <ul>
                @foreach (var child in visibleChildren)
                {
                    @await Html.PartialAsync("custom/SidebarItem", child, ViewData)
                }
            </ul>
        </div>
    }
    else
    {
        <a href="@navUrl" target="@navTarget" class="nav-item-btn @(isCurrentPage ? "active" : "") flex-grow-1 text-decoration-none text-reset py-2 ps-2 pe-1 d-flex align-items-center" style="justify-content: flex-start;">
            <i class="bi @iconClass me-2"></i>
            <span>@linkTitle</span>
        </a>
    }
</li>