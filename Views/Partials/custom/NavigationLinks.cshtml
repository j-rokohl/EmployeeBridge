@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Web.Common
@inject UmbracoHelper Umbraco
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    var navNode = Umbraco.Content(Guid.Parse("b7240911-2628-4030-8901-dc0c782cb5c0"));
    var menuBlocks = navNode?.Value<BlockListModel>("menuBlocks");
}

@if (menuBlocks != null && menuBlocks.Any())
{
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="/"><img style="height: 30px;" src="/media/k0qfvto0/employee-bridge.svg"></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarScroll"
                    aria-controls="navbarScroll" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarScroll">
                <ul class="navbar-nav me-auto my-2 my-lg-0">
                    @foreach (var block in menuBlocks)
                    {
                        var content = block.Content;

                        if (content.ContentType.Alias == "navItem")
                        {
                            var link = content.Value<IEnumerable<Link>>("navLink")?.FirstOrDefault();
                            if (link != null)
                            {
                                var isActive = Model.Url() == link.Url ? "active" : "";
                                <li class="nav-item">
                                    <a class="nav-link @isActive" href="@link.Url" target="@link.Target">@link.Name</a>
                                </li>
                            }
                        }
                        else if (content.ContentType.Alias == "navDropdown")
                        {
                            var title = content.Value<string>("title");
                            var subLinks = content.Value<IEnumerable<Link>>("subLinks");

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @title
                                </a>
                                @if (subLinks != null && subLinks.Any())
                                {
                                    <ul class="dropdown-menu">
                                        @foreach (var subLink in subLinks)
                                        {
                                            var isSubActive = Model.Url() == subLink.Url ? "active" : "";
                                            <li>
                                                <a class="dropdown-item @isSubActive" href="@subLink.Url" target="@subLink.Target">
                                                    @subLink.Name
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    }
                </ul>
                <form class="d-flex" role="search" action="./search">
                    <input class="nav-search form-control" type="search" placeholder="Search" aria-label="Search" name="q">
                    <button class="nav-search-btn" type="submit" aria-label="Search"><i class="bi bi-search me-2"></i></button>
                </form>
            </div>
        </div>
    </nav>
}