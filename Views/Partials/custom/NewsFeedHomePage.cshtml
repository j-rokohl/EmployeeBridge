@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions

@{
    // Find the main Blog parent node relative to the home node
    var blogParent = Model.Children.FirstOrDefault(x => x.ContentType.Alias == "blog") 
                  ?? UmbracoContext.Content?.GetAtRoot()
                        .FirstOrDefault(x => x.ContentType.Alias == "home")?
                        .Children.FirstOrDefault(x => x.ContentType.Alias == "blog");

    // Fetch ALL visible blog items ordered by published date
    var allBlogs = blogParent?.Children<IPublishedContent>()
        .Where(x => x.ContentType.Alias == "blogItem" && x.IsVisible())
        .OrderByDescending(x => x.CreateDate);
}

@if (allBlogs != null && allBlogs.Any())
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var article in allBlogs)
        {
            var image = article.Value<IPublishedContent>("thumbnailImage");
            var depts = article.Value<IEnumerable<IPublishedContent>>("departments");

            <div class="col">
                <div class="card h-100">
                    @if (image != null)
                    {
                        <img src="@image.Url()" class="card-img-top" alt="@article.Name" />
                    }
                    <div class="card-body d-flex flex-column">
                        <!-- Department Badges -->
                        @if (depts != null && depts.Any())
                        {
                            <div class="mb-2">
                                @foreach (var dept in depts)
                                {
                                    <span class="badge bg-secondary me-1">@dept.Name</span>
                                }
                            </div>
                        }
                        
                        <h5 class="card-title">@article.Name</h5>
                        <p class="card-text">@article.Value("introText")</p>
                        <a href="@article.Url()" class="btn btn-primary mt-auto">Read Post</a>
                    </div>
                </div>
            </div>
        }
    </div>
}