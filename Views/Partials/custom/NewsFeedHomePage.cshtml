@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    // Find the news landing page to generate clean, dynamic URLs
    var newsPage = Umbraco.ContentAtRoot()
        .SelectMany(x => x.DescendantsOrSelf())
        .FirstOrDefault(x => string.Equals(x.ContentType.Alias, "blogListPage", StringComparison.OrdinalIgnoreCase));

    var newsBaseUrl = newsPage?.Url() ?? "/news/";

    // Fetch the 6 most recent visible articles
    var allNews = Umbraco.ContentAtRoot()
        .SelectMany(x => x.DescendantsOrSelf())
        .Where(x => string.Equals(x.ContentType.Alias, "blogItemPage", StringComparison.OrdinalIgnoreCase) && x.IsVisible())
        .OrderByDescending(x => x.Value<DateTime?>("publicationDate") ?? x.CreateDate) 
        .Take(6) 
        .ToList();
}

@if (allNews.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-5">
        @foreach (var article in allNews)
        { 
            var pubDate = article.Value<DateTime?>("publicationDate") ?? article.CreateDate;
            
            // Fetch all picked departments as a collection
            var departments = article.Value<IEnumerable<IPublishedContent>>("department") ?? Enumerable.Empty<IPublishedContent>();

            <div class="col">
                <div class="card card-bulma-box h-100" data-aos="zoom-in">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@article.Name</h5>
                        <p class="card-text text-muted small mb-2">
                            @pubDate.ToString("MMMM d, yyyy")
                        </p>

                        @if (departments.Any())
                        {
                            <div class="mb-2 d-flex flex-wrap gap-1">
                                @foreach (var dept in departments)
                                {
                                    var deptUrl = $"{newsBaseUrl}?deptId={dept.Id}";
                                    <a href="@deptUrl" class="text-decoration-none">
                                        <span class="badge bg-success">@dept.Name</span>
                                    </a>
                                }
                            </div>
                        }

                        <p class="card-text">@article.Value("introText")</p>
                        
                        <div class="d-grid gap-2 col-12 mx-auto mt-auto pt-3">
                            <a href="@article.Url()" class="btn btn-primary px-5">Read Post</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-center text-muted">No news posts found.</p>
}