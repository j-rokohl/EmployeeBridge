@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Strings
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListModel>

@{
    var cards = Model;
    if (cards == null || !cards.Any()) return;

    // Safely extract the columns count passed via ViewData
    int columns = ViewData["ItemsPerRow"] is int colVal && colVal > 0 ? colVal : 4;
}

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-@columns g-4 ps-4 pe-4 gradient-container">
    @foreach (var item in cards)
    {
        var card = item.Content;
        var buttonLink = card.Value<IEnumerable<Link>>("gradientCardLink")?.FirstOrDefault() 
                        ?? card.Value<Link>("gradientCardLink");

        <div class="col">
            @if (card.HasValue("gradientCardLink"))
            {
                if (buttonLink != null)
                {
            <a href="@buttonLink.Url" class="text-decoration-none gradient-anchor"
            target="@(string.IsNullOrWhiteSpace(buttonLink.Target) ? "_self" : buttonLink.Target)">
                <div class="card card-bulma-box card-gradient h-100">
                    <!-- Changed flex-column to flex-row -->
                    <div class="card-body d-flex flex-row justify-content-between align-items-center">
                        
                        <!-- Left Side: Text Container -->
                        <div>
                            <!-- Removed col-12 mx-auto to let the text align left naturally -->
                            <div class="d-grid gap-2 mt-auto pt-3 pb-3">
                                <h5 class="card-gradient-text mb-0">@buttonLink.Name</h5>
                            </div>
                        </div>
                        
                        <!-- Right Side: Large Arrow -->
                        <span class="fs-1"><i class="bi bi-chevron-right fs-1 text-white-50"></i></span>
                        
                    </div>
                </div>
            </a>
                }
            }            
        </div>
    }
</div>