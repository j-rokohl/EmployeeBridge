@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Strings
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockListModel>

@{
    var cards = Model;
    if (cards == null || !cards.Any()) return;

    // Get column count passed from HomePage
    int columns = ViewData["ItemsPerRow"] != null ? (int)ViewData["ItemsPerRow"] : 4;
}

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-@columns g-5">
    @foreach (var item in cards)
    {
        var card = item.Content;

        var image = card.Value<IPublishedContent>("cardImage");
        var title = card.Value<string>("cardTitle");
        var description = card.Value<IHtmlEncodedString>("cardDescription");
        var buttonLink = card.Value<IEnumerable<Link>>("cardButton")?.FirstOrDefault() 
                                        ?? card.Value<Link>("cardButton");

        <div class="col">
            <div class="card card-bulma-box h-100">
                @if (image != null)
                {
                    <img src="@image.Url()" class="card-img-top" alt="@(image.Value<string>("altText") ?? title)">
                }
                <div class="card-body d-flex flex-column">
                    @if (!string.IsNullOrWhiteSpace(title))
                    {
                        <h5 class="card-title">@title</h5>
                    }
                    @if (description != null && !string.IsNullOrWhiteSpace(description.ToHtmlString()))
                    {
                        <div class="card-text">
                            @description
                        </div>
                    }
                    @if (card.HasValue("cardButton"))
                    {
                        if (buttonLink != null)
                        {
                            <div class="d-grid gap-2 col-12 mx-auto mt-auto pt-3">
                                <a href="@buttonLink.Url" 
                                target="@(string.IsNullOrWhiteSpace(buttonLink.Target) ? "_self" : buttonLink.Target)" 
                                class="btn btn-primary">
                                    @(string.IsNullOrWhiteSpace(buttonLink.Name) ? "Learn More" : buttonLink.Name)
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>