@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models
@model IPublishedElement

@{
    if (Model == null) return;

    var name = Model.Value<string>("fullName");
    var title = Model.Value<string>("jobTitle");
    var email = Model.Value<string>("email");
    var phone = Model.Value<string>("officePhone");
    var cell = Model.Value<string>("cellPhone");
    var avatar = Model.Value<MediaWithCrops>("photo");

    var directReports = Model.Value<BlockListModel>("reports");
}

<li>
    <div class="card tree-card shadow-sm border-light-subtle">
        <div class="card-body p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="avatar-container">
                    @if (avatar != null)
                    {
                        <img src="@avatar.Url()" alt="@name" class="img-fluid rounded-circle" />
                    }
                    else
                    {
                        <i class="bi bi-person-circle fs-1 text-secondary"></i>
                    }
                </div>
                <div class="flex-grow-1 min-w-0">
                    <div class="fw-bold text-dark text-truncate">@name</div>
                    <div class="text-uppercase text-secondary fw-semibold mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                        @title
                    </div>
                    <div class="text-muted small text-truncate mb-2">
                        @if (!string.IsNullOrWhiteSpace(email))
                        {
                        <a href="mailto:@email" class="text-decoration-none blue-link"><span><i class="bi bi-envelope-fill"></i> @email</span></a>
                        }
                    </div>
                    <div class="d-flex gap-3 small text-secondary">
                        @if (!string.IsNullOrWhiteSpace(phone))
                        {
                            <a href="tel:@phone" class="text-decoration-none blue-link"><span><i class="bi bi-telephone-fill"></i> @phone</span></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(cell))
                        {
                            <a href="tel:@cell" class="text-decoration-none blue-link"><span><i class="bi bi-phone-fill"></i> @cell</span></a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Recursive step: render direct reports using explicit path *@
    @if (directReports != null && directReports.Any())
    {
        <ul class="tree-ul">
            @foreach (var report in directReports)
            {
                @await Html.PartialAsync("~/Views/Partials/custom/staffTree.cshtml", report.Content)
            }
        </ul>
    }
</li>