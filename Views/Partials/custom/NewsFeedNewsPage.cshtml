@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@{
    // Read query string parameters
    var deptFilter = Context.Request.Query["deptId"].ToString();
    var searchQuery = Context.Request.Query["q"].ToString()?.Trim() ?? string.Empty;
    
    int.TryParse(deptFilter, out int selectedDeptId);

    // 1. Query all visible 'blogItemPage' nodes
    var query = Umbraco.ContentAtRoot()
        .SelectMany(x => x.DescendantsOrSelf())
        .Where(x => x != null && string.Equals(x.ContentType.Alias, "blogItemPage", StringComparison.OrdinalIgnoreCase) && x.IsVisible());

    // 2. Apply Department Filter if query parameter exists
    if (selectedDeptId > 0)
    {
        query = query.Where(article => {
            var depts = article.Value<IEnumerable<IPublishedContent>>("department") 
                        ?? Enumerable.Empty<IPublishedContent>();
            var singleDept = article.Value<IPublishedContent>("department");
            
            return depts.Any(d => d != null && d.Id == selectedDeptId) || (singleDept != null && singleDept.Id == selectedDeptId);
        });
    }

    // 3. Apply Search Query Filter if 'q' parameter exists
    if (!string.IsNullOrWhiteSpace(searchQuery))
    {
        var searchTerm = searchQuery.ToLowerInvariant();

        query = query.Where(article => {
            var title = (article.Name ?? string.Empty).ToLowerInvariant();
            var intro = (article.Value<string>("introText") ?? string.Empty).ToLowerInvariant();

            return title.Contains(searchTerm) || intro.Contains(searchTerm);
        });
    }

    var allNews = query
        .OrderByDescending(x => x.Value<DateTime?>("publicationDate") ?? x.CreateDate)
        .Take(6)
        .ToList();
}

<div class="row g-4">
    @* Left Column (9 cols wide) - News Articles *@
    <div class="col-lg-9">
        @if (selectedDeptId > 0 || !string.IsNullOrWhiteSpace(searchQuery))
        {
            var activeDept = Umbraco.Content(selectedDeptId);
            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="fw-bold">Filtering by:</span>
                    @if (!string.IsNullOrWhiteSpace(searchQuery))
                    {
                        <span class="badge bg-primary">Keyword: "@searchQuery"</span>
                    }
                    @if (selectedDeptId > 0)
                    {
                        <span class="badge bg-primary">Department: @(activeDept?.Name ?? "Selected")</span>
                    }
                </div>
                <a href="@Model.Url()" class="btn btn-sm btn-outline-secondary">Clear Filters</a>
            </div>
        }

        @if (allNews.Any())
        {
            foreach (var article in allNews)
            { 
                var pubDate = article.Value<DateTime?>("publicationDate") ?? article.CreateDate;
                var selectedDept = article.Value<IEnumerable<IPublishedContent>>("department")?.FirstOrDefault()
                                   ?? article.Value<IPublishedContent>("department");
                var selectedAuth = article.Value<IEnumerable<IPublishedContent>>("author")?.FirstOrDefault() 
                                   ?? article.Value<IPublishedContent>("author");

                <div class="mb-4">
                    <a href="@article.Url()" class="text-decoration-none">
                        <h5 class="card-title text-dark headline">@article.Name</h5>
                    </a>
                    <p class="card-text text-muted small mb-1 mt-1">
                        By @(selectedAuth?.Name ?? "Staff") | @pubDate.ToString("MMMM d, yyyy")
                    </p>
                    @if (selectedDept != null)
                    {
                        <div class="mb-2">
                            <span class="badge bg-success">@selectedDept.Name</span>
                        </div>
                    }
                    <p class="mb-3 text-secondary">@article.Value("introText")</p>
                    <div class="border-bottom"></div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No news posts found matching your criteria.</p>
        }
    </div>

    @* Right Column (3 cols wide) - Department List Sidebar *@
    <div class="col-lg-3">
        @await Html.PartialAsync("custom/DepartmentSearchSidebar", Model)
    </div>
</div>